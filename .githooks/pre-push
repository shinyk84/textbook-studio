#!/bin/sh

# 코드 변경을 원격에 올릴 때 WORKLOG.md가 같은 푸시 범위에 포함됐는지 확인한다.
# 작업의 의미는 대화 맥락을 아는 편집자/AI가 기록하고, 이 Hook은 누락만 막는다.

zero_sha="0000000000000000000000000000000000000000"
blocked=0

while read local_ref local_sha remote_ref remote_sha
do
  [ "$local_sha" = "$zero_sha" ] && continue

  if [ "$remote_sha" = "$zero_sha" ]; then
    base_sha="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
    if [ -n "$base_sha" ]; then
      changed_files="$(git diff --name-only "$base_sha..$local_sha")"
    else
      changed_files="$(git diff-tree --root --no-commit-id --name-only -r "$local_sha")"
    fi
  else
    changed_files="$(git diff --name-only "$remote_sha..$local_sha")"
  fi

  code_changed="$(printf '%s\n' "$changed_files" | grep -Ev '^(HANDOFF\.md|WORKLOG\.md|AGENTS\.md|README\.md|\.githooks/|setup-hooks\.cmd)$' || true)"
  worklog_changed="$(printf '%s\n' "$changed_files" | grep -E '^WORKLOG\.md$' || true)"

  if [ -n "$code_changed" ] && [ -z "$worklog_changed" ]; then
    echo ""
    echo "[교과서 스튜디오] 푸시를 멈췄습니다."
    echo "코드가 변경됐지만 WORKLOG.md가 이번 푸시에 포함되지 않았습니다."
    echo "작업 목적·수정 내용·검증·다음 작업을 기록한 뒤 다시 커밋·푸시해 주세요."
    echo ""
    blocked=1
  fi
done

exit "$blocked"
